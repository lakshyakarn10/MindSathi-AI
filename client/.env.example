# ============================================================
# MindSathi Frontend — Environment Variables
# Copy this file to .env.local for local development.
# Set these as environment variables in Vercel for production.
# ============================================================

# Backend API base URL
# Leave empty or unset when using Vercel rewrites (recommended for production).
# Set to your Render backend URL if NOT using Vercel rewrites:
#   VITE_API_URL=https://mindsathi-backend.onrender.com/api/v1
VITE_API_URL=

# WebSocket base URL for real-time chat
# Leave empty to auto-derive from window.location (works with Vercel rewrites proxy).
# Set explicitly for production if using Render directly:
#   VITE_WS_URL=wss://mindsathi-backend.onrender.com/api/v1
VITE_WS_URL=

# Google Maps proxy (Forge)
# Only needed if the Map feature is enabled.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# OAuth Portal (optional)
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
