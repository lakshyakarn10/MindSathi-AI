# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=sqlite:///./mindsaathi.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/mindsaathi

# JWT Authentication
JWT_SECRET_KEY=mindsaathi_super_secret_jwt_key_development_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application & CORS
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173
PROJECT_NAME=MindSaathi API
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & Encryption (AES-256 for Journal at rest)
JOURNAL_ENCRYPTION_KEY=mindsaathi_32_byte_aes_secret_key_demo!

# National Crisis & Resource Integration
TELE_MANAS_RESOURCE_URL=https://telemanas.mohfw.gov.in/
TELE_MANAS_HELPLINE=14416

# Privacy & k-Anonymity
MAX_AGGREGATE_GROUP_SIZE=15
MIN_COHORT_PRIVACY_THRESHOLD=15

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_GENERAL_PER_MINUTE=100
